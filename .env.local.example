NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Prefer the publishable key name for new projects. Local Supabase status
# also shows this value as the anon key, so the fallback variable is supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_status_anon_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_status_anon_key

# Server-only. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_status_service_role_key
